# Environment
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=replace-with-a-strong-dev-secret

# Initial Superadmin
DATABASE_SEEDING_ENABLED=false
SUPERADMIN_DOCUMENT=
SUPERADMIN_FIRST_NAME=
SUPERADMIN_LAST_NAME=
SUPERADMIN_EMAIL=

# Email notifications (DEV example; do not commit production secrets)
Email__Enabled=true
Email__Host=mailpit
Email__Port=1025
Email__UseTls=false
Email__UseSsl=false
Email__Username=
Email__Password=
Email__FromName=Portal Libre Expresión
Email__FromAddress=notificaciones@libreexpresion.test
Email__PortalBaseUrl=http://127.0.0.1:5173
Email__EnvironmentLabel=DESARROLLO
