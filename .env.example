# Environment
ASPNETCORE_ENVIRONMENT=Development
AUTH_USE_DOCUMENT_TEMPORARY_PASSWORD=false

# PostgreSQL
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=replace-with-a-strong-dev-secret

# Initial Superadmin
DATABASE_SEEDING_ENABLED=false
SUPERADMIN_DOCUMENT=
SUPERADMIN_FIRST_NAME=
SUPERADMIN_LAST_NAME=
SUPERADMIN_EMAIL=

# Email notifications (misma cuenta Gmail remitente; completar fuera de Git)
Email__Enabled=true
Email__Host=smtp.gmail.com
Email__Port=587
Email__UseTls=true
Email__UseSsl=false
Email__Username=
Email__Password=
Email__FromName=Portal Libre Expresión
Email__FromAddress=
Email__PortalBaseUrl=http://127.0.0.1:5173
Email__EnvironmentLabel=DESARROLLO
